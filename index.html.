<script>
(function(){
var pages=[].slice.call(document.querySelectorAll('.page')),names=pages.map(function(p){return p.dataset.page});
var links=[].slice.call(document.querySelectorAll('#nav a[data-nav]'));
function show(name,target){
  document.documentElement.removeAttribute("data-r");
  pages.forEach(function(p){p.classList.toggle('active',p.dataset.page===name)});
  links.forEach(function(a){if(a.dataset.nav===name)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current')});
  document.title=(name==='home'?'':name.charAt(0).toUpperCase()+name.slice(1)+' | ')+'Negros Occidental High School (NOHS)';
  if(target&&target!==document.getElementById('page-'+name))target.scrollIntoView();else window.scrollTo(0,0);
  var nav=document.getElementById('nav'),mb=document.getElementById('menuBtn');
  var hd=document.querySelector('header.site');if(hd)hd.classList.remove('open');if(mb)mb.setAttribute('aria-expanded','false');
}
function route(){
  var id=decodeURIComponent(location.hash.slice(1))||'home';
  if(id==='top'||id==='main')id='home';
  if(names.indexOf(id)>-1)return show(id);
  var el=document.getElementById(id),pg=el&&el.closest('.page');
  if(pg)return show(pg.dataset.page,el);
  show('home');
}
window.addEventListener('hashchange',route);route();
var d=document.getElementById('dismiss');
if(d)d.addEventListener('click',function(){document.getElementById('notice').style.display='none'});
var mb=document.getElementById('menuBtn'),nav=document.getElementById('nav');
if(mb)mb.addEventListener('click',function(){var o=document.querySelector('header.site').classList.toggle('open');mb.setAttribute('aria-expanded',o)});
})();
</script>
